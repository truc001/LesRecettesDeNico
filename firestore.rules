rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed data model
    // ===============================================================
    // recipes/{recipeId}
    //   title, category, description, duration, servings, emoji,
    //   ingredients, steps: bounded safe strings
    //   contributor: optional bounded safe string
    //   featured: bool; createdAt: immutable timestamp
    //   sourceId: optional immutable string
    // Public read; administrator-only create/update/delete.
    //
    // recipeSubmissions/{submissionId}
    //   same recipe strings plus contributor
    //   submitterUid: immutable Firebase UID
    //   status: pending; createdAt: immutable timestamp
    // Google user create, only together with a submissionLimits write;
    // administrator-only read and delete (moderation removes the proposal).
    //
    // submissionLimits/{uid}
    //   windowStart: timestamp opening the current 24 h window
    //   count: submissions made in that window (1 to 5)
    //   lastAt: request time of the latest submission
    //   lastSubmissionId: ID of the submission created by the same write
    // Owner get/create/update, only together with a new submission.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isGoogleUser() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isAdmin() {
      return isGoogleUser()
        && request.auth.token.email == 'appcraft31@gmail.com';
    }

    function isRecent(value) {
      return value is timestamp
        && value <= request.time
        && value > request.time - duration.value(5, 'm');
    }

    function validSafeText(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum
        && value.matches('^[^<>`\\x00-\\x09\\x0B-\\x1F\\x7F-\\x9F\\x{200B}-\\x{200F}\\x{202A}-\\x{202E}\\x{2066}-\\x{2069}\\x{FEFF}]*$')
        && !value.matches('(?is).*(javascript|vbscript|data)[ ]*:.*');
    }

    function hasValidRecipeText(data) {
      return validSafeText(data.title, 1, 200)
        && validSafeText(data.category, 1, 80)
        && validSafeText(data.description, 1, 1000)
        && validSafeText(data.duration, 1, 80)
        && validSafeText(data.servings, 1, 80)
        && validSafeText(data.emoji, 1, 16)
        && validSafeText(data.ingredients, 0, 4000)
        && validSafeText(data.steps, 0, 4000)
        && (!('contributor' in data) || validSafeText(data.contributor, 0, 60));
    }

    function isValidRecipe(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'duration', 'servings', 'emoji', 'ingredients', 'steps', 'featured', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'description', 'duration', 'servings', 'emoji', 'ingredients', 'steps', 'contributor', 'featured', 'createdAt', 'sourceId'])
        && hasValidRecipeText(data)
        && data.featured is bool
        && data.createdAt is timestamp
        && (!('sourceId' in data) || validSafeText(data.sourceId, 1, 128));
    }

    function hasValidSubmissionText(data) {
      return validSafeText(data.title, 3, 200)
        && validSafeText(data.category, 1, 80)
        && validSafeText(data.description, 1, 1000)
        && validSafeText(data.duration, 1, 80)
        && validSafeText(data.servings, 1, 80)
        && validSafeText(data.emoji, 1, 16)
        && validSafeText(data.ingredients, 3, 4000)
        && validSafeText(data.steps, 3, 4000)
        && validSafeText(data.contributor, 0, 60)
        && validSafeText(data.submitterUid, 1, 128);
    }

    function isValidSubmission(data) {
      return data.keys().hasAll(['title', 'category', 'description', 'duration', 'servings', 'emoji', 'ingredients', 'steps', 'contributor', 'submitterUid', 'status', 'createdAt'])
        && data.keys().hasOnly(['title', 'category', 'description', 'duration', 'servings', 'emoji', 'ingredients', 'steps', 'contributor', 'submitterUid', 'status', 'createdAt'])
        && hasValidSubmissionText(data)
        && data.createdAt is timestamp
        && data.status == 'pending';
    }

    function submissionLimit(uid) {
      return /databases/$(database)/documents/submissionLimits/$(uid);
    }

    function submission(submissionId) {
      return /databases/$(database)/documents/recipeSubmissions/$(submissionId);
    }

    // lastAt can only equal request.time through a server timestamp, which
    // proves that the limit was written by this very request.
    function isValidSubmissionLimit(data) {
      return data.keys().hasAll(['windowStart', 'count', 'lastAt', 'lastSubmissionId'])
        && data.keys().hasOnly(['windowStart', 'count', 'lastAt', 'lastSubmissionId'])
        && data.windowStart is timestamp
        && data.count is int
        && data.lastAt == request.time
        && data.lastSubmissionId is string
        && data.lastSubmissionId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && !exists(submission(data.lastSubmissionId))
        && existsAfter(submission(data.lastSubmissionId));
    }

    function opensSubmissionWindow(data) {
      return data.windowStart == request.time && data.count == 1;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isAdmin()
        && isValidRecipe(request.resource.data)
        && recipeId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && isRecent(request.resource.data.createdAt);
      allow update: if isAdmin()
        && isValidRecipe(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt', 'sourceId']);
      allow delete: if isAdmin();
    }

    match /recipeSubmissions/{submissionId} {
      allow create: if isGoogleUser()
        && isValidSubmission(request.resource.data)
        && request.resource.data.submitterUid == request.auth.uid
        && submissionId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && isRecent(request.resource.data.createdAt)
        && getAfter(submissionLimit(request.auth.uid)).data.lastAt == request.time
        && getAfter(submissionLimit(request.auth.uid)).data.lastSubmissionId == submissionId;
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /submissionLimits/{uid} {
      allow get: if isGoogleUser() && request.auth.uid == uid;
      allow create: if isGoogleUser()
        && request.auth.uid == uid
        && isValidSubmissionLimit(request.resource.data)
        && opensSubmissionWindow(request.resource.data);
      allow update: if isGoogleUser()
        && request.auth.uid == uid
        && isValidSubmissionLimit(request.resource.data)
        && (
          (resource.data.windowStart <= request.time - duration.value(24, 'h') && opensSubmissionWindow(request.resource.data))
          || (resource.data.windowStart > request.time - duration.value(24, 'h')
            && request.resource.data.windowStart == resource.data.windowStart
            && request.resource.data.count == resource.data.count + 1
            && request.resource.data.count <= 5)
        );
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
